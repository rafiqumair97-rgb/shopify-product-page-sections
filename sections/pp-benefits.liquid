{%- comment -%}
  Product benefits row: icon/image + heading + short text per block.
  Use it under the product form to answer "why buy this?" at a glance.
{%- endcomment -%}

<div class="pp-benefits page-width" style="--pp-cols: {{ section.settings.columns }}; --pp-accent: {{ section.settings.accent }};">
  {%- if section.settings.heading != blank -%}
    <h2 class="pp-benefits__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="pp-benefits__grid" role="list">
    {%- for block in section.blocks -%}
      <li class="pp-benefits__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img
            class="pp-benefits__icon"
            src="{{ block.settings.image | image_url: width: 160 }}"
            alt="{{ block.settings.image.alt | escape }}"
            width="56" height="56" loading="lazy"
          >
        {%- else -%}
          <span class="pp-benefits__dot" aria-hidden="true"></span>
        {%- endif -%}
        <h3 class="pp-benefits__title">{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}
          <div class="pp-benefits__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

<style>
  .pp-benefits { padding: 40px 16px; text-align: center; }
  .pp-benefits__heading { margin: 0 0 28px; }
  .pp-benefits__grid {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 24px;
    grid-template-columns: repeat(var(--pp-cols), minmax(0, 1fr));
  }
  .pp-benefits__icon { width: 56px; height: 56px; object-fit: contain; }
  .pp-benefits__dot { display: inline-block; width: 14px; height: 14px; border-radius: 50%; background: var(--pp-accent); }
  .pp-benefits__title { margin: 12px 0 6px; font-size: 1.05em; }
  .pp-benefits__text { opacity: .8; font-size: .95em; }
  .pp-benefits__text p { margin: 0; }
  @media (max-width: 749px) {
    .pp-benefits__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

{% schema %}
{
  "name": "Product benefits",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why you'll love it" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "color", "id": "accent", "label": "Dot color (when no icon)", "default": "#c28b4a" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Clean ingredients" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short, specific reason to buy.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Clean ingredients" } },
        { "type": "benefit", "settings": { "title": "Free shipping over $50" } },
        { "type": "benefit", "settings": { "title": "30-day returns" } },
        { "type": "benefit", "settings": { "title": "Made in small batches" } }
      ]
    }
  ]
}
{% endschema %}
