{%- comment -%}
  FAQ accordion built on native <details>/<summary> (works without JavaScript).
  Also outputs FAQPage structured data so Google can show rich results.
{%- endcomment -%}

<div class="pp-faq page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="pp-faq__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pp-faq__list">
    {%- for block in section.blocks -%}
      <details class="pp-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary class="pp-faq__question">{{ block.settings.question }}</summary>
        <div class="pp-faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.add_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
  .pp-faq { padding: 40px 16px; max-width: 820px; }
  .pp-faq__heading { text-align: center; margin: 0 0 24px; }
  .pp-faq__item { border-bottom: 1px solid rgba(0,0,0,.12); }
  .pp-faq__question {
    list-style: none; cursor: pointer; padding: 18px 32px 18px 0; position: relative; font-weight: 600;
  }
  .pp-faq__question::-webkit-details-marker { display: none; }
  .pp-faq__question::after {
    content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
    font-size: 1.4em; transition: transform .2s ease;
  }
  .pp-faq__item[open] .pp-faq__question::after { transform: translateY(-50%) rotate(45deg); }
  .pp-faq__answer { padding: 0 0 18px; opacity: .85; }
  .pp-faq__answer p { margin: 0 0 8px; }
</style>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section",
  "max_blocks": 15,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "checkbox", "id": "add_schema", "label": "Add FAQ structured data (SEO)", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders ship in 1–2 business days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>Returns are accepted within 30 days.</p>" } },
        { "type": "question", "settings": { "question": "Is this product right for sensitive skin?", "answer": "<p>Add a clear, honest answer here.</p>" } }
      ]
    }
  ]
}
{% endschema %}
